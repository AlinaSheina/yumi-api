{
  "name": "yumi-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:start": "node dist/mcp/server.js",
    "login": "tsx src/cli/login.ts",
    "test:live": "tsx --test test/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "node-html-parser": "^6.1.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^18.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
